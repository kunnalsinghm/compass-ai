# Copy this file to .env and fill in values as needed. Compass works with
# nothing set except the Guard connection - everything else is an optional
# tuning knob with a documented default.

PORT=4100
COMPASS_HOST=0.0.0.0

# ---------------------------------------------------------------------
# Guard connection (REQUIRED) - see server/guardDb.js. Compass reads
# Guard's usage/pricing/RBAC data read-only; it never writes to Guard's
# database and never talks to a model provider directly.
# ---------------------------------------------------------------------

# The base URL of your running Guard instance - Compass forwards
# (possibly re-routed) requests here for governance, metering, and the
# real provider call.
GUARD_BASE_URL=http://localhost:4000

# Which storage backend Guard itself uses: "sqlite" (default) or "postgres".
GUARD_DB_DRIVER=sqlite

# Required when GUARD_DB_DRIVER=sqlite (the default). Path to Guard's
# actual data/finops.db file - Compass opens it READ-ONLY. If Guard and
# Compass are co-located self-hosted processes sharing a data volume
# (see docker-compose.yml), this is usually a mounted path like
# /guard-data/finops.db.
GUARD_DB_PATH=../finops-mvp/data/finops.db

# Required when GUARD_DB_DRIVER=postgres. Same Postgres database Guard
# itself is configured with.
GUARD_POSTGRES_URL=
# Only relevant if Guard was deployed with FINOPS_POSTGRES_SCHEMA set to
# something other than the default.
GUARD_POSTGRES_SCHEMA=

# ---------------------------------------------------------------------
# Compass's own storage - separate database from Guard's, see
# server/storage/. "sqlite" (default) or "postgres".
# ---------------------------------------------------------------------
COMPASS_DB_DRIVER=sqlite
COMPASS_DB_PATH=
COMPASS_POSTGRES_URL=
COMPASS_POSTGRES_SCHEMA=compass

# ---------------------------------------------------------------------
# Caching (server/cache.js, server/semanticCache.js) - opt-in per request
# via X-Compass-Cache / X-Compass-Semantic-Cache headers.
# ---------------------------------------------------------------------
COMPASS_CACHE_TTL_SECONDS=300
COMPASS_SEMANTIC_CACHE_MODE=local
COMPASS_SEMANTIC_CACHE_THRESHOLD=
COMPASS_SEMANTIC_CACHE_TTL_SECONDS=300
# Required only for embedding mode - Anthropic has no first-party
# embeddings endpoint, so this always calls an OpenAI-compatible one.
COMPASS_EMBEDDING_API_KEY=
COMPASS_EMBEDDING_BASE_URL=https://api.openai.com/v1/embeddings
# Comma-separated substrings - a prompt containing any of them is never
# cached, exactly or semantically. Coarse and customer-configurable, not
# real PII detection (Guard's own PII redaction is a different, upstream
# concern).
COMPASS_SEMANTIC_CACHE_EXCLUDE=

# ---------------------------------------------------------------------
# Routing (server/router.js) - opt-in per request via
# X-Compass-Enable-Routing: true.
# ---------------------------------------------------------------------
# provider:fallbackProvider pairs, comma-separated, e.g.
# "openai:anthropic,anthropic:openai" - used only when the primary
# provider call itself fails (an outage), never as a cost decision.
COMPASS_PROVIDER_FALLBACK=

# ---------------------------------------------------------------------
# Evaluation layer (server/evaluation/) - deterministic checks always
# run when a rubric is provided; the LLM judge only runs if configured.
# ---------------------------------------------------------------------
# Defaults to calling Claude - point this at any Anthropic-Messages-
# compatible endpoint instead if you'd rather use a different judge model.
COMPASS_JUDGE_BASE_URL=https://api.anthropic.com/v1/messages
COMPASS_JUDGE_API_KEY=
COMPASS_JUDGE_MODEL=claude-sonnet-4-6
COMPASS_JUDGE_ANTHROPIC_VERSION=2023-06-01

# ---------------------------------------------------------------------
# Recommendation engine (server/recommend.js) - confidence-state
# thresholds. Defaults match the numbers used throughout this build.
# ---------------------------------------------------------------------
COMPASS_MIN_TRAFFIC_EVENTS=20
COMPASS_MIN_EVAL_SAMPLES=5
COMPASS_SIMILARITY_THRESHOLD=0.85
COMPASS_DETERMINISTIC_PASS_THRESHOLD=0.9
COMPASS_MIN_HUMAN_REVIEW=3

# How often (minutes) recommendations are automatically regenerated from
# current Guard spend, and how often live rollouts are re-checked for
# automatic rollback. Set to 0 to disable either schedule (you can still
# trigger both manually from the dashboard/API).
COMPASS_RECOMMENDATION_REFRESH_MINUTES=60
COMPASS_AUTO_ROLLBACK_CHECK_MINUTES=15

# Minimum evaluation samples before a rollout can go ABOVE the 5% canary.
# Canary stays ungated (it is how evidence is gathered); wider needs this many
# samples and no "diverges" verdict, or a human override with a note.
COMPASS_MIN_SAMPLES_FOR_WIDE_ROLLOUT=30

# How often (minutes) Guard's flagged test cases (thumbs-down, high retry,
# low shadow similarity) are imported as Compass evaluation cases. 0 = off.
COMPASS_GUARD_SIGNAL_SYNC_MINUTES=30

# ---------------------------------------------------------------------
# Guard integration (server/guardClient.js, guardDb.js)
# ---------------------------------------------------------------------
GUARD_BASE_URL=http://localhost:4000
# Time to first byte from Guard, ms.
COMPASS_GUARD_TIMEOUT_MS=
# Report cache hits to Guard as zero-token events so Guard's dashboards see
# them. Set false to disable.
COMPASS_REPORT_CACHE_HITS=true
# Cap on bytes captured from a streamed response for caching / shadow tests.
COMPASS_MAX_STREAM_CAPTURE_BYTES=
# Outage failover model per provider, e.g. "openai:gpt-4o,anthropic:claude-sonnet".
# Default: same quality tier on the other provider. The caller must also send
# X-Compass-Fallback-Provider-Key (their key for the fallback provider).
COMPASS_FALLBACK_MODELS=

# Multi-tenant: set when Guard runs with FINOPS_MULTI_TENANT=true (needs
# Postgres for both). Compass then scopes every table by Guard's tenant id.
COMPASS_MULTI_TENANT=false
# Guard's shared control-plane schema (api_keys/tenants live here).
GUARD_CONTROL_PLANE_SCHEMA=control_plane
# Multi-tenant seed target (seed.js refuses to guess a customer).
COMPASS_SEED_TENANT_ID=

COMPASS_JSON_LIMIT=5mb
COMPASS_LOG_DIR=
